{
  "name": "ember-undeprecate-ember-a",
  "version": "0.0.0",
  "description": "A() from @ember/array as a v2 addon, without Ember's deprecated array mixins",
  "keywords": [
    "ember-addon",
    "babel-plugin"
  ],
  "repository": "https://github.com/NullVoxPopuli/ember-undeprecate-ember-a",
  "license": "MIT",
  "author": "NullVoxPopuli",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native-array": {
      "types": "./declarations/native-array.d.ts",
      "default": "./dist/native-array.js"
    },
    "./babel-plugin": "./babel-plugin.cjs",
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "babel-plugin.cjs",
    "declarations",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-transform-typescript": "^7.25.2",
    "@babel/runtime": "^7.25.6",
    "@ember/library-tsconfig": "^1.0.0",
    "@embroider/addon-dev": "^8.1.0",
    "@eslint/js": "^9.17.0",
    "@glint/ember-tsc": "^1.0.3",
    "@rollup/plugin-babel": "^6.0.4",
    "concurrently": "^9.0.1",
    "ember-source": "~7.4.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-ember": "^12.3.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.15.1",
    "globals": "^16.1.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.16",
    "rollup": "^4.22.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.19.1"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs"
  },
  "peerDependencies": {
    "ember-source": ">= 5.12.0"
  }
}
